# PIN to access the app from any device on your home network
APP_PIN=changeme

# AI provider API keys (only the ones you use)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Ollama endpoint (if using local models)
OLLAMA_BASE_URL=http://localhost:11434

# Port for the app server
PORT=3000

# Set to "false" to disable prompt variation (A/B baseline). Omit or set to any other value to enable.
# VITE_DIVERSIFY_PROMPTS=false

# Ollama sampling overrides — injected only when set; omit to use the model's baked-in values.
# VITE_OLLAMA_MIN_P=0.03
# VITE_OLLAMA_TEMPERATURE=1.1
# VITE_OLLAMA_TOP_K=40
# VITE_OLLAMA_TOP_P=0.9
